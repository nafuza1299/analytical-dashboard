{
  "name": "analytical-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A static analytics dashboard over the World Bank Indicators API — no backend, no API key.",
  "author": "nafuza1299",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nafuza1299/analytical-dashboard.git"
  },
  "homepage": "https://analytical-dashboard.vercel.app/",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "react",
    "typescript",
    "dashboard",
    "recharts",
    "vite",
    "world-bank"
